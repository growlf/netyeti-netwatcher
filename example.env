# NetWatch AI Environment Configuration
# Copy this file to .env and modify as needed. Docker Compose will automatically
# pick up these variables and apply them to the stack.

# Ports for exposed services
VICTORIA_PORT=8428
CHROMA_PORT=8000

# Path to the SSH directory on the host machine to mount into the agent container
# This provides the agent with access to SSH keys and config for network device polling.
# Default is ~/.ssh, but you can change it if your keys are stored elsewhere.
HOST_SSH_DIR=~/.ssh

# Agent Collection Interval in seconds (default is 3600 = 1 hour)
COLLECTION_INTERVAL_SECONDS=3600

# Enable automatic LAN discovery using nmap on agent startup (true/false)
AUTO_DISCOVERY=true
